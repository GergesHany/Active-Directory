# Active Directory Docker Configuration (EXAMPLE - Copy to .env and customize)
# DO NOT commit .env file to version control!

# Domain Configuration
DOMAIN=EXAMPLE.COM
DOMAINPASS=ChangeThisPassword123!

# Network Configuration
DNSFORWARDER=8.8.8.8
HOSTIP=172.20.0.10

# LDAP Connection Configuration
AD_SERVER=localhost
AD_PORT=389
AD_BASE_DN=DC=EXAMPLE,DC=COM
AD_USERNAME=CN=Administrator,CN=Users,DC=EXAMPLE,DC=COM
AD_PASSWORD=ChangeThisPassword123!

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Update the passwords with strong, unique values
# 3. Never commit the .env file to version control
